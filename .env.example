# Copy this file to .env and fill in real values. Never commit .env (see .gitignore).

# --- General ---
NODE_ENV=development

# --- Postgres (used by docker-compose.yml and apps/api via DATABASE_URL) ---
POSTGRES_USER=tgads
POSTGRES_PASSWORD=tgads_dev_password
POSTGRES_DB=tgads
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tgads:tgads_dev_password@localhost:5432/tgads

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=3000
# Secret used to sign session JWTs issued after Telegram initData validation. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- apps/bot (grammY) ---
# Get this from @BotFather on Telegram. Never guess or fake this value.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where apps/miniapp is served, required by Telegram WebApp
MINIAPP_URL=
# Optional links shown in the bot's main menu (docs/ROADMAP.md phase 2). Left blank, the
# corresponding button is simply omitted rather than pointing somewhere fake.
PLATFORM_CHANNEL_URL=
PLATFORM_SUPPORT_URL=

# --- apps/miniapp (Vite) ---
# Base URL of apps/api, as reachable from the browser. Vite only exposes VITE_-prefixed vars.
VITE_API_URL=http://localhost:3000

# --- apps/admin ---
# Secret used to sign admin panel session JWTs (separate from the Telegram-facing JWT_SECRET)
ADMIN_JWT_SECRET=

# --- Payments: Telegram Stars (phase 3) ---
# No extra credentials needed beyond TELEGRAM_BOT_TOKEN; Stars payments go through sendInvoice with currency=XTR.

# --- Payments: Rial gateway (phase 8 — requires user decision + real merchant credentials, see docs/ARCHITECTURE.md) ---
RIAL_GATEWAY_MERCHANT_ID=
RIAL_GATEWAY_API_KEY=

# --- Payments: Crypto TRC-20 (phase 8) ---
TRON_GRID_API_KEY=
TRON_HD_WALLET_MNEMONIC=
