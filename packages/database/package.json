{
  "name": "@telegram-ads/database",
  "private": true,
  "version": "0.0.1",
  "description": "Shared Prisma schema + generated client (see docs/ARCHITECTURE.md #3)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "echo \"[database] nothing to lint (prisma schema has its own formatter)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
