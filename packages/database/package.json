{
  "name": "@telegram-ads/database",
  "private": true,
  "version": "0.0.1",
  "description": "Shared Prisma schema + generated client (see docs/ARCHITECTURE.md #3)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" -c ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
